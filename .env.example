# PostgreSQL System of Record
DATABASE_URL=sqlite:///./ecdat_pqc.db

# Optional MongoDB Document Store
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=ecdat_cbom

# Security, JWT & Upload Boundaries
UPLOAD_DIR=./workspace_scans
MAX_UPLOAD_SIZE_MB=200
JWT_SECRET=ecdat-pqc-cbom-secret-key-2026-super-secure-32bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Planning Horizons
REFERENCE_YEAR=2026
Q_DAY_PLANNING_YEAR=2035

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]

# Frontend API URL
VITE_API_BASE_URL=/api/v1

# SMTP Email & Password Reset Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
FRONTEND_BASE_URL=http://localhost:8000
PASSWORD_RESET_EXPIRE_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

